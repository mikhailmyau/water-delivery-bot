# === Telegram ===
BOT_TOKEN=

# ID администраторов через запятую, например: 123456789,987654321
ADMIN_IDS=

# ID группы, куда приходят карточки новых заказов (необязательно)
ADMIN_GROUP_ID=

# === База данных ===
# Локально (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./storage/db.sqlite3
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://water_bot:water_bot@postgres:5432/water_bot

# === Платежи ===
# mock — тестовый провайдер, работает из коробки без реального шлюза
# yookassa — боевой провайдер ЮKassa
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_SECRET=

# Публичный адрес бота, нужен для формирования return_url и webhook (для боевого провайдера)
PUBLIC_BASE_URL=http://localhost:8080

# Хост и порт, на которых поднимается aiohttp-сервер приёма webhook от платёжного провайдера
PAYMENT_WEBHOOK_HOST=0.0.0.0
PAYMENT_WEBHOOK_PORT=8080
PAYMENT_WEBHOOK_PATH=/payments/webhook

# === Напоминания о неоплаченных заказах (в минутах) ===
REMINDER_FIRST_DELAY_MINUTES=30
REMINDER_SECOND_DELAY_MINUTES=180

# === Прочее ===
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow
REDIS_URL=
DEBUG=false
